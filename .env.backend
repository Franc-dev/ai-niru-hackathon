# Backend Environment Configuration

# Local Model URLs
LOCAL_MODEL_URL=http://localhost:8002/v1/chat
LOCAL_EMBEDDING_URL=

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ai_niru

# JWT Auth
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (comma-separated or JSON array)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://ai-niru-hackathon.vercel.app

# RAG/Vector DB
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_data
RAG_COLLECTION_NAME=rag_docs
RAG_TOP_K=5

# ElevenLabs (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_SW=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_AGENT_ID_EN=
ELEVENLABS_AGENT_ID_SW=

# Environment
ENVIRONMENT=development
DEBUG=true

