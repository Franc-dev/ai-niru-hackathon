# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ai_niru

# Vector DB (chroma for local RAG)
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_data
RAG_COLLECTION_NAME=rag_docs
RAG_TOP_K=5

# Local model (trained on our synthetic data)
LOCAL_MODEL_URL=http://localhost:8001/v1/chat
LOCAL_EMBEDDING_URL=http://localhost:8001/v1/embeddings

# Environment
ENVIRONMENT=development
DEBUG=true


 = "your-pinecone-api-key-here"
# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://ai-niru-hackathon.vercel.app
